//@version=5
strategy("Champion 2 - Small Dip (calm-open long)", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, commission_type=strategy.commission.cash_per_contract, commission_value=0.62, slippage=1, calc_on_every_tick=false)

// SMALL DIP - buy a calm open. Use the 1-MINUTE chart of NQ1! or MNQ1!.
// Rule: dip = 09:30 open minus the lowest low of 09:30-09:44. If the dip is at most 0.5 x the standard deviation of the previous
//       30 days' dips, buy at 09:50. Stop 1.5% from the fill, no target, flat at 15:55 ET. Skips news days.
// My replay 2015-10 to 2026-10, 1 contract, after costs: about +12,300 pts (698 trades).
// Honest warning: this is the piece most likely to be partly overfitted - a walk-forward test kept only about a third of its backtest profit.

if barstate.isfirst and timeframe.period != "1"
    runtime.error("Use the 1-minute chart")

qty      = input.int(1, "Contracts", minval=1)
calmMult = input.float(0.5, "Calm if dip <= x standard deviations", step=0.1)
stopPct  = input.float(1.5, "Stop (%)", step=0.1) / 100
skipNews = input.bool(true, "Skip news days")

tz = "America/New_York"
hm = hour(time, tz) * 100 + minute(time, tz)
shifted    = time + 6 * 60 * 60 * 1000
skey       = year(shifted, tz) * 10000 + month(shifted, tz) * 100 + dayofmonth(shifted, tz)
newSession = skey != skey[1]

var float[] dips  = array.new_float()
var float[] vhist = array.new_float()
var float v830 = 0.0
var bool newsDay = false
var float o930 = na
var float dLow = na
var int dN = 0
var bool calm = false

if newSession
    v830 := 0.0
    newsDay := false
    o930 := na
    dLow := na
    dN := 0
    calm := false

if hm >= 830 and hm < 835
    v830 += volume
if hm == 834
    newsDay := array.size(vhist) >= 10 and v830 >= 3 * array.avg(vhist)
    array.push(vhist, v830)
    if array.size(vhist) > 20
        array.shift(vhist)
if hm == 930
    o930 := open
if hm >= 930 and hm < 945
    dLow := na(dLow) ? low : math.min(dLow, low)
    dN += 1

// decide on the close of the 09:44 bar using the previous 30 days
if hm == 944 and dN >= 14 and not na(o930)
    dip = o930 - dLow
    if array.size(dips) >= 2
        calm := dip <= calmMult * array.stdev(dips, false)
    array.push(dips, dip)
    if array.size(dips) > 30
        array.shift(dips)

// buy on the close of the 09:49 bar -> fills at the 09:50 open
if hm == 949 and calm and not (skipNews and newsDay)
    strategy.entry("Small Dip", strategy.long, qty=qty)

if strategy.position_size > 0
    strategy.exit("x Small Dip", "Small Dip", stop=strategy.position_avg_price * (1 - stopPct), comment="stop")

if hm == 1554
    strategy.close_all(comment="time exit")
    strategy.cancel_all()

plot(strategy.position_size > 0 ? strategy.position_avg_price * (1 - stopPct) : na, "Stop", color=color.red, style=plot.style_linebr)
